use tauri::State;

use crate::Db;
use crate::models::link::{Link, LinkInput};
use crate::repository::link_repository;

type CmdResult<T> = Result<T, String>;

fn validate(input: &LinkInput) -> Result<(), String> {
    if input.title.trim().is_empty() {
        return Err("链接名称不能为空".into());
    }
    if input.url.trim().is_empty() {
        return Err("链接地址不能为空".into());
    }
    Ok(())
}

#[tauri::command]
pub fn add_link(db: State<Db>, project_id: String, input: LinkInput) -> CmdResult<Link> {
    validate(&input)?;
    let conn = db.0.lock().map_err(|_| "数据库忙，请稍后重试".to_string())?;
    let link = link_repository::insert(&conn, &project_id, &input)
        .map_err(|e| format!("数据库操作失败: {e}"))?;
    let message = if input.link_type.as_deref() == Some("github") {
        "添加 GitHub 链接".to_string()
    } else {
        format!("添加链接：{}", input.title.trim())
    };
    crate::repository::activity_repository::log(&conn, &project_id, "link", &message);
    Ok(link)
}

#[tauri::command]
pub fn update_link(db: State<Db>, id: String, input: LinkInput) -> CmdResult<()> {
    validate(&input)?;
    let conn = db.0.lock().map_err(|_| "数据库忙，请稍后重试".to_string())?;
    link_repository::update(&conn, &id, &input).map_err(|e| format!("数据库操作失败: {e}"))?;
    Ok(())
}

#[tauri::command]
pub fn delete_link(db: State<Db>, id: String) -> CmdResult<()> {
    let conn = db.0.lock().map_err(|_| "数据库忙，请稍后重试".to_string())?;
    link_repository::delete(&conn, &id).map_err(|e| format!("数据库操作失败: {e}"))?;
    Ok(())
}
